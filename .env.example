# =====================================================================
# Srinivasa Technology - Production Tracking & Heat Traceability System
# Copy this file to .env and fill in real values. NEVER commit .env
# =====================================================================

# Django
SECRET_KEY=CHANGE_THIS
DEBUG=False

# Comma-separated list of hostnames/IPs allowed to access the server.
# Replace SERVER-IP with the actual LAN IP of the server PC.
ALLOWED_HOSTS=localhost,127.0.0.1,SERVER-IP

# Session lifetime in seconds (default 8 hours)
SESSION_COOKIE_AGE=28800

# ---------------------------------------------------------------------
# MySQL 8.x ONLY
# ---------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=srinivasa_traceability
DB_USER=srinivasa_app
DB_PASSWORD=CHANGE_THIS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
